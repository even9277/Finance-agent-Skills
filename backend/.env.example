# backend/.env — 后端覆盖配置（可选，不填则从 Financial-MCP-Agent/.env 继承）
# 复制为 backend/.env 按需填写

# ── 数据库 ────────────────────────────────────────────────────
# Phase 1 默认使用 SQLite，无需配置
# DATABASE_URL=sqlite+aiosqlite:///./finance.db

# Phase 生产切 PostgreSQL（需先启动 docker-compose postgres 服务）:
# DATABASE_URL=postgresql+asyncpg://finance:finance123@localhost:5432/finance_db

# ── 服务器 ────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# ── CORS（逗号分隔，可追加生产域名）────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Feature Flags ─────────────────────────────────────────────
# Phase 2 STM（短期记忆）：当前默认保留 token 预算驱动的 preflight 压缩 + overflow fallback
# ENABLE_STM=true     # 开启后：启用 STM、WebSocket 流式打字机、preflight/fallback 压缩
# ENABLE_STM=false    # 关闭时：行为与 Phase 1 完全一致（默认）
# 同步 overflow / admin 应急压缩（compress_if_needed），与 preflight token 阈值无关
# STM_FALLBACK_MIN_UNCOMPRESSED_MESSAGES=10
# STM_FALLBACK_COMPACTION_TIMEOUT_SEC=45
# STM_COMPACTION_MODEL=                      # 压缩摘要模型；留空时回退复用 OPENAI_COMPATIBLE_MODEL
# STM_COMPACTION_API_KEY=                    # 留空时回退复用 OPENAI_COMPATIBLE_API_KEY
# STM_COMPACTION_BASE_URL=                   # 留空时回退复用 OPENAI_COMPATIBLE_BASE_URL
# STM_HOT_UPDATE_MODEL=tongyixiaomi-flash     # 热更新字段抽取模型（固定 temperature=0）
# STM_HOT_UPDATE_API_KEY=                    # 留空时回退复用 OPENAI_COMPATIBLE_API_KEY
# STM_HOT_UPDATE_BASE_URL=                   # 留空时回退复用 OPENAI_COMPATIBLE_BASE_URL
# STM_HOT_RECENT_USER_WINDOW=6               # 热更新额外参考的最近 user 消息窗口大小
# 兼容旧名（仍可读）：STM_COMPRESS_THRESHOLD、STM_COMPACTION_TIMEOUT_SEC
# STM_KEEP_RECENT=20          # 压缩时至少保留最近 N 条原始消息
# Rolling summary / preflight baseline（当前主链路已接入 preflight）
# CHAT_CONTEXT_WINDOW_TOKENS=34000   # 本地调试可临时调低，便于快速触发 preflight 压缩；生产建议回到更高值
# STM_SUMMARY_PREFLIGHT_ENABLED=true
# STM_SUMMARY_RESERVE_TOKENS_FLOOR=20000   # 给模型输出预留的安全空间
# STM_SUMMARY_SOFT_THRESHOLD_TOKENS=4000   # 额外软缓冲，避免贴边触发
# STM_SUMMARY_OVERHEAD_TOKENS=4096         # system/memory/tool runtime 额外预算
# STM_SUMMARY_CHUNK_PARTS=2                # 压缩时最多分段摘要的块数
# STM_SUMMARY_MIN_MESSAGES_FOR_SPLIT=4     # 消息过少时不做分段
# STM_SUMMARY_RETRY_ATTEMPTS=2             # 预留：摘要重试次数
# STM_SUMMARY_MAX_QUALITY_RETRIES=1        # 预留：审计失败后的质量重试次数
# STM_SUMMARY_STRICT_IDENTIFIER_CHECK=true # 预留：标识符严格校验
# STM_PREFLIGHT_TIMEOUT_MS=5000            # 本地/测试建议 >= 4000，避免刚触发就超时
# STM_SUMMARY_CAS_RETRY_LIMIT=1            # CAS 冲突后的额外重试次数
# STM_SUMMARY_AUDIT_SAMPLE_RATE=0.1        # 10% 采样足够观测，不会过量打日志
# STM_ROUTE_SLICE_MAX_ENTITIES=4           # Route/Rewrite 注入的 active_entities 最大条数
# STM_ANSWER_POLICY_MAX_CONSTRAINTS=8      # Answer policy 注入的 constraints 最大条数
# Auth（账号登录 + JWT）
# AUTH_ENABLED=true
# JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080

# Phase 1 Skill-First Chat：对话模式接入 Router/Executor + Tushare 数据技能
# ENABLE_CHAT_SKILLS=false     # 默认关闭，关闭时行为与现网一致
# ENABLE_TUSHARE_SKILLS=false  # 默认关闭，需与 ENABLE_CHAT_SKILLS 配合启用
# ENABLE_TUSHARE_PLANNER=false
# ENABLE_TUSHARE_MARKET_TOOLS=false
# ENABLE_TUSHARE_INDEX_TOOLS=false
# ENABLE_TUSHARE_SECTOR_TOOLS=false
# ENABLE_FUNDAMENTAL_ANALYSIS=false
# ENABLE_SECTOR_ANALYSIS=false
# ENABLE_STOCK_SELECTION=false
# ENABLE_DETERMINISTIC_SKILL_EXECUTION=true
# ENABLE_TOOL_PREFETCH_CONCURRENCY=true
# ENABLE_TRACE=true
# ENABLE_TRACE_DB_SINK=false   # 开发环境方案 B 可设为 true，将 span/trace 写入 trace_sessions/trace_spans（失败仅降级为文件）
# ENABLE_EVIDENCE_LINEAGE=true
# ENABLE_TRACE_ARTIFACT_REFS=false
# ENABLE_TRACE_PROMPT_CAPTURE=false
# ENABLE_TRACE_REPLY_CAPTURE=false
# ENABLE_LANGFUSE=false
# ENABLE_SKILL_LIFECYCLE=false
# ENABLE_SKILL_LOADER_V2=false
# ENABLE_REFERENCE_INDEX_V2=false
# ENABLE_WEB_SEARCH_V2=false
# WEB_SEARCH_SHADOW_MODE=true
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_TIMEOUT_MS=4000
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_DEFAULT_LOOKBACK_DAYS=7
# WEB_SEARCH_DAILY_QUOTA=100
# TAVILY_API_KEY=                 # 真实 key 只写本地 .env / CI secret，不写入仓库
# TAVILY_INCLUDE_DOMAINS=
# TAVILY_EXCLUDE_DOMAINS=
# TUSHARE_POINTS_LEVEL=2000
# TUSHARE_TOOL_PROFILE=points_2000
# TUSHARE_DISABLE_HIGH_TIER_TOOLS=true
# TUSHARE_PROBE_ENABLED_TOOLS=true
# REALCALL_SCHEDULE_ENABLED=false
# LANGFUSE_UPLOAD_PROMPT_REPLY=false
# CHAT_ROUTER_MODEL=tongyi-xiaomi-analysis-pro
# CHAT_RESOLVER_MODEL=tongyi-xiaomi-analysis-pro
# CHAT_REWRITER_MODEL=tongyi-xiaomi-analysis-pro
# CHAT_SKILL_SYNTHESIS_MODEL=glm-5.1
# TRACE_ARTIFACT_DIR=/root/Finance/Financial-MCP-Agent/logs/chat_trace_artifacts
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PROJECT=
# LANGFUSE_ENV=dev
# LANGFUSE_RELEASE=
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_FLUSH_AT=20
# LANGFUSE_FLUSH_INTERVAL_SEC=5
# TUSHARE_TOKEN=your_token     # Linux/venv/uv 环境下配置；未配置时自动降级到普通对话

# Phase 3 LTM（长期记忆，Mem0 + pgvector）：跨会话用户画像
# ENABLE_MEMORY=false # Phase 3 激活
# ENABLE_CHAT_LTM_EXTRACT=false      # A0: 对话到LTM抽取（灰度开关，默认关闭）
# ENABLE_SUMMARY_LTM_EXTRACT=false   # A0: 摘要到LTM抽取（压缩后触发，默认关闭）
# ENABLE_MEMORY_CANDIDATE_POOL=false # Agent ltm_worker 内遗留候选池，默认关闭；开启前需先补齐 memory_candidates / memory_audit_logs
# ENABLE_PREWRITE_DEDUPE=false       # A阶段: 入库前去重/冲突治理（默认关闭）
