# backend/.env — 后端覆盖配置（可选，不填则从 Financial-MCP-Agent/.env 继承）
# 复制为 backend/.env 按需填写

# ── 数据库 ────────────────────────────────────────────────────
# Phase 1 默认使用 SQLite，无需配置
# DATABASE_URL=sqlite+aiosqlite:///./finance.db

# Phase 生产切 PostgreSQL（需先启动 docker-compose postgres 服务）:
# DATABASE_URL=postgresql+asyncpg://finance:finance123@localhost:5432/finance_db

# ── 服务器 ────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# ── CORS（逗号分隔，可追加生产域名）────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Feature Flags ─────────────────────────────────────────────
# Phase 2 STM（短期记忆）：对话多轮压缩 + WebSocket 流式输出
# ENABLE_STM=true     # 开启后：对话模式 10 轮自动压缩，WebSocket 流式打字机效果
# ENABLE_STM=false    # 关闭时：行为与 Phase 1 完全一致（默认）
# STM_COMPRESSION_STRATEGY=dynamic_budget   # dynamic_budget | legacy_count
# STM_CONTEXT_BUDGET_TOKENS=32000
# STM_CONTEXT_TARGET_RATIO=0.72
# STM_CONTEXT_HARD_RATIO=0.85
# STM_RESPONSE_RESERVE_TOKENS=1200
# STM_MEMORY_RESERVE_TOKENS=600
# STM_CONTEXT_SAFETY_MARGIN_TOKENS=1000
# STM_STAGE_OVERHEAD_TOKENS=600
# STM_KEEP_RECENT=4
# STM_LEGACY_COUNT_THRESHOLD=10
# STM_WORKER_INTERVAL_SEC=3
# STM_WORKER_BATCH_SIZE=10
# STM_WORKER_MAX_RETRIES=3
# STM_SUMMARY_PROVIDER=openai  # 离线 Compose 显式使用 deterministic
# LTM_CANDIDATE_PROVIDER=deterministic  # openai 仅在受保护真实验收中显式启用
# LTM_CANDIDATE_TIMEOUT_SEC=30
# LTM_WORKER_INTERVAL_SEC=5
# LTM_WORKER_BATCH_SIZE=10
# LTM_WORKER_MAX_RETRIES=3
# LTM_WORKER_LEASE_SEC=60  # 必须大于候选模型超时至少 5 秒
# STM_SUMMARY_TIMEOUT_SEC=30
# STM_WORKER_LEASE_SEC=60  # 必须大于摘要超时至少 5 秒

# Redis 记忆热缓存（可选；PostgreSQL 始终是权威源，Redis 停机时自动回源）
# ENABLE_REDIS_CACHE=false
# REDIS_URL=redis://localhost:6379/0  # 如含密码请只写本地 .env，禁止提交
# REDIS_CACHE_NAMESPACE=finance-agent
# REDIS_CACHE_TTL_SEC=300
# REDIS_CACHE_LEASE_SEC=5
# REDIS_SINGLEFLIGHT_WAIT_MS=40
# REDIS_CONNECT_TIMEOUT_SEC=0.25
# REDIS_SOCKET_TIMEOUT_SEC=0.50
# REDIS_MAX_CONNECTIONS=20

# Auth（账号登录 + JWT）
# AUTH_ENABLED=true
# JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080

# Phase 1 Skill-First Chat：对话模式接入 Router/Executor + Tushare 数据技能
# ENABLE_CHAT_SKILLS=false     # 默认关闭，关闭时行为与现网一致
# ENABLE_TUSHARE_SKILLS=false  # 默认关闭，需与 ENABLE_CHAT_SKILLS 配合启用
# ENABLE_TUSHARE_PLANNER=false
# ENABLE_TUSHARE_MARKET_TOOLS=false
# ENABLE_TUSHARE_INDEX_TOOLS=false
# ENABLE_TUSHARE_SECTOR_TOOLS=false
# ENABLE_FUNDAMENTAL_ANALYSIS=false
# ENABLE_SECTOR_ANALYSIS=false
# ENABLE_STOCK_SELECTION=false
# ENABLE_DETERMINISTIC_SKILL_EXECUTION=true
# ENABLE_TOOL_PREFETCH_CONCURRENCY=true
# ENABLE_TRACE=true
# ENABLE_EVIDENCE_LINEAGE=true
# ENABLE_TRACE_ARTIFACT_REFS=false
# ENABLE_TRACE_PROMPT_CAPTURE=false
# ENABLE_TRACE_REPLY_CAPTURE=false
# ENABLE_LANGFUSE=false
# CHAT_ROUTER_MODEL=kimi-k2.5
# CHAT_RESOLVER_MODEL=kimi-k2.5
# CHAT_SKILL_SYNTHESIS_MODEL=
# TRACE_ARTIFACT_DIR=/root/Finance/Financial-MCP-Agent/logs/chat_trace_artifacts
# CHAT_TRACE_JSONL_PATH=/root/Finance/Financial-MCP-Agent/logs/chat_traces.jsonl
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PROJECT=
# LANGFUSE_ENV=dev
# LANGFUSE_RELEASE=
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_FLUSH_AT=20
# LANGFUSE_FLUSH_INTERVAL_SEC=5
# TUSHARE_TOKEN=your_token     # Linux/venv/uv 环境下配置；未配置时自动降级到普通对话

# Phase 3 LTM（长期记忆，Mem0 + pgvector）：跨会话用户画像
# ENABLE_MEMORY=false # Phase 3 激活
