# backend/.env — 后端覆盖配置（可选，不填则从 Financial-MCP-Agent/.env 继承）
# 复制为 backend/.env 按需填写

# ── 数据库 ────────────────────────────────────────────────────
# Phase 1 默认使用 SQLite，无需配置
# DATABASE_URL=sqlite+aiosqlite:///./finance.db

# Phase 生产切 PostgreSQL（需先启动 docker-compose postgres 服务）:
# DATABASE_URL=postgresql+asyncpg://finance:finance123@localhost:5432/finance_db

# ── 服务器 ────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# ── CORS（逗号分隔，可追加生产域名）────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Feature Flags ─────────────────────────────────────────────
# Phase 2 STM（短期记忆）：对话多轮压缩 + WebSocket 流式输出
# ENABLE_STM=true     # 开启后：对话模式 10 轮自动压缩，WebSocket 流式打字机效果
# ENABLE_STM=false    # 关闭时：行为与 Phase 1 完全一致（默认）

# Auth（账号登录 + JWT）
# AUTH_ENABLED=true
# JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080

# Phase 1 Skill-First Chat：对话模式接入 Router/Executor + Tushare 数据技能
# ENABLE_CHAT_SKILLS=false     # 默认关闭，关闭时行为与现网一致
# ENABLE_TUSHARE_SKILLS=false  # 默认关闭，需与 ENABLE_CHAT_SKILLS 配合启用
# ENABLE_TUSHARE_PLANNER=false
# ENABLE_TUSHARE_MARKET_TOOLS=false
# ENABLE_TUSHARE_INDEX_TOOLS=false
# ENABLE_TUSHARE_SECTOR_TOOLS=false
# ENABLE_FUNDAMENTAL_ANALYSIS=false
# ENABLE_SECTOR_ANALYSIS=false
# ENABLE_STOCK_SELECTION=false
# ENABLE_DETERMINISTIC_SKILL_EXECUTION=true
# ENABLE_TOOL_PREFETCH_CONCURRENCY=true
# CHAT_ROUTER_MODEL=kimi-k2.5
# CHAT_RESOLVER_MODEL=kimi-k2.5
# CHAT_SKILL_SYNTHESIS_MODEL=
# TUSHARE_TOKEN=your_token     # Linux/venv/uv 环境下配置；未配置时自动降级到普通对话

# Phase 3 LTM（长期记忆，Mem0 + pgvector）：跨会话用户画像
# ENABLE_MEMORY=false # Phase 3 激活
