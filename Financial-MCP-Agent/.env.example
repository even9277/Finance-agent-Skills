# OpenAI Compatible API（通义千问 / 阿里云 DashScope 示例）
# 请复制此文件为 .env 并填入你的 API Key，勿将 .env 提交到 Git

# 阿里云 DashScope 兼容模式示例：
# OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPATIBLE_MODEL=glm-5.1 或 qwen-plus / qwen-turbo / qwen-max

OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key
OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_COMPATIBLE_MODEL=glm-5.1
USE_LOCAL_MODEL=api

# Skills P6 / Web Search v2（仅示例，真实密钥写入 .env 或 Secret Manager，不提交）
ENABLE_SKILL_LIFECYCLE=false
ENABLE_SKILL_LOADER_V2=false
ENABLE_REFERENCE_INDEX_V2=false
ENABLE_WEB_SEARCH_V2=false
WEB_SEARCH_SHADOW_MODE=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_TIMEOUT_MS=4000
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_DEFAULT_LOOKBACK_DAYS=7
WEB_SEARCH_DAILY_QUOTA=100
TAVILY_API_KEY=
TAVILY_INCLUDE_DOMAINS=
TAVILY_EXCLUDE_DOMAINS=

# Tushare：用户当前为 2000 积分档，运行前需用 check-credentials 探测可用接口。
TUSHARE_TOKEN=
TUSHARE_POINTS_LEVEL=2000
TUSHARE_TOOL_PROFILE=points_2000
TUSHARE_DISABLE_HIGH_TIER_TOOLS=true
TUSHARE_PROBE_ENABLED_TOOLS=true

# ========================================
# 观测系统总开关
# ========================================
# ENABLE_SKILL_TRACE=true  → 开启所有追踪写入（默认行为）
# ENABLE_SKILL_TRACE=false → 一键关闭所有追踪，不写任何日志文件，主流程不受影响
# 用途：压测时临时关闭以减少 I/O 开销；线上出现性能问题时紧急关闭
ENABLE_SKILL_TRACE=true

# 会话 Markdown 报告（依赖 ENABLE_SKILL_TRACE=true 才生效）
# 每个会话生成一份 logs/session_reports/{session_id}.md，便于人工复盘
ENABLE_SESSION_REPORT=true

# 数据库落库开关（默认关闭，开启前需先完成表结构创建）
# 开启后 trace 数据会同时写入 trace_sessions / trace_spans 两张表
# 写库失败自动降级为仅文件落盘，不中断主流程
ENABLE_TRACE_DB_SINK=false

# Langfuse 自测上传；默认不上传 prompt/reply 正文。
ENABLE_LANGFUSE=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_UPLOAD_PROMPT_REPLY=false
LANGFUSE_SAMPLE_RATE=1.0
