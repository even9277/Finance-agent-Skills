# OpenAI Compatible API（通义千问 / 阿里云 DashScope 示例）
# 请复制此文件为 .env 并填入你的 API Key，勿将 .env 提交到 Git

# 阿里云 DashScope 兼容模式示例：
# OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPATIBLE_MODEL=qwen3.5-flash 或 qwen-plus / qwen-turbo / qwen-max

OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key
OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_COMPATIBLE_MODEL=qwen3.5-flash
USE_LOCAL_MODEL=api
